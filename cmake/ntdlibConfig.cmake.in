# find_package(ntdlib) reads this file. The file finds xsflib first, and seqlib if ntdlib was built with
# NTDLIB_SEQUENCE_EXPORT. ntdlib's targets come last.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(NTDLIB_DISC @NTDLIB_DISC@)
set(NTDLIB_SEQUENCE_EXPORT @NTDLIB_SEQUENCE_EXPORT@)

find_dependency(xsflib 1.0)
if (NTDLIB_SEQUENCE_EXPORT)
    find_dependency(seqlib 1.0)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/ntdlibTargets.cmake)
check_required_components(ntdlib)
